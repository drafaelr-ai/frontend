{
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/pagar/:token", "destination": "/api/pagar-meta?token=:token" },
    { "source": "/solicitacao/:token", "destination": "/api/solicitacao-meta?token=:token" }
  ]
}
